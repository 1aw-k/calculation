   <property name="styleSheet">
    <string>QMainWindow {
    background-color: #f3f3f3;
}
QWidget#centralwidget {
    background-color: #f3f3f3;
}
QLabel#expressionLabel {
    color: #5f6368;
    font-size: 14px;
    padding: 0px 6px 0px 6px;
}
QLineEdit#displayLineEdit {
    min-height: 74px;
    background-color: #ffffff;
    color: #202124;
    border: 1px solid #c8c6c4;
    border-radius: 6px;
    padding: 6px 14px 6px 14px;
    font-size: 32px;
    font-weight: 500;
}
QLineEdit#displayLineEdit[error="true"] {
    color: #b3261e;
    border: 1px solid #b3261e;
}
QPushButton {
    min-width: 62px;
    min-height: 52px;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    background-color: #ffffff;
    color: #202124;
    font-size: 19px;
}
QPushButton:hover {
    background-color: #f7f7f7;
}
QPushButton:pressed {
    background-color: #e8e8e8;
}
QPushButton[role="digit"] {
    font-size: 21px;
    font-weight: 500;
}
QPushButton[role="operator"] {
    background-color: #ededed;
    font-size: 22px;
}
QPushButton[role="operator"]:hover {
    background-color: #e4e4e4;
}
QPushButton[role="action"] {
    background-color: #e5e5e5;
    font-size: 17px;
}
QPushButton[role="equals"] {
    background-color: #0067c0;
    border-color: #0067c0;
    color: #ffffff;
    font-size: 24px;
}
QPushButton[role="equals"]:hover {
    background-color: #005a9e;
    border-color: #005a9e;
}
QPushButton[role="equals"]:pressed {
    background-color: #004578;
    border-color: #004578;
}</string>
