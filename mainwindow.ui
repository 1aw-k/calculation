   <property name="styleSheet">
    <string>QMainWindow {
    background-color: #1f1f1f;
}
QWidget#centralwidget {
    background-color: #1f1f1f;
}
QLabel#expressionLabel {
    color: #bdbdbd;
    font-size: 15px;
    padding: 0px 8px 0px 8px;
}
QLineEdit#displayLineEdit {
    min-height: 86px;
    background-color: #292929;
    color: #ffffff;
    border: 2px solid #3b3b3b;
    border-radius: 8px;
    padding: 10px 16px 10px 16px;
    font-size: 36px;
    font-weight: 600;
}
QLineEdit#displayLineEdit[error="true"] {
    color: #ffb4ab;
    border: 2px solid #ffb4ab;
}
QPushButton {
    min-width: 64px;
    min-height: 56px;
    border: none;
    border-radius: 8px;
    background-color: #383838;
    color: #ffffff;
    font-size: 22px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #454545;
}
QPushButton:pressed {
    background-color: #505050;
}
QPushButton[role="digit"] {
    background-color: #3b3b3b;
    font-size: 23px;
}
QPushButton[role="operator"] {
    background-color: #2f2f2f;
    color: #75d0ff;
    font-size: 24px;
}
QPushButton[role="operator"]:hover {
    background-color: #3b3b3b;
}
QPushButton[role="action"] {
    background-color: #2b2b2b;
    color: #d8d8d8;
    font-size: 18px;
}
QPushButton[role="memory"] {
    min-height: 44px;
    background-color: #2b2b2b;
    color: #d8d8d8;
    font-size: 16px;
}
QPushButton[role="equals"] {
    background-color: #0f6cbd;
    border: 2px solid #75d0ff;
    color: #ffffff;
    font-size: 28px;
}
QPushButton[role="equals"]:hover {
    background-color: #0d5fa6;
}
QPushButton[role="equals"]:pressed {
    background-color: #0b4f8a;
}</string>
